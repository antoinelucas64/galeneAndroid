<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allows cleartext only for localhost (local development).
        CIDR IP ranges are not valid as <domain> on Android — using 10.0.0.0/8 etc.
        caused silent errors.
        A Galène server over WSS (TLS) needs no special configuration.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
